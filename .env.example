# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/pdf_bench"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Storage (set STORAGE_DRIVER=local for dev, s3 for prod)
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./storage"
AWS_BUCKET_NAME=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Anthropic API (for VLM ground truth pipeline)
ANTHROPIC_API_KEY=""

# Mistral OCR (Stage 3 fallback)
MISTRAL_API_KEY=""

# Google Document AI (Stage 3 final fallback)
GCP_PROJECT=""
GDAI_PROCESSOR_ID=""
GOOGLE_APPLICATION_CREDENTIALS=""  # path to service account JSON

# Internal worker URL (Next.js calls this to trigger metric computation)
INTERNAL_WORKER_URL="http://localhost:3000"
WORKER_SECRET="change-me-in-production"
